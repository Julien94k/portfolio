# Copier en .env puis remplir. Le fichier .env n'est jamais commité.

# Base de données. Générer avant le premier démarrage : openssl rand -hex 24
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=

# Administration des messages (/admin). Laisser l'empreinte vide ferme l'administration.
# Pour choisir le mot de passe : ./scripts/set-admin-password.sh
ADMIN_USERNAME=julien
ADMIN_PASSWORD_HASH=

# Notification sur le téléphone à chaque message (application ntfy, abonnée au topic). Vide = désactivé.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

PUBLIC_URL=https://julienhome.com
HOST_PORT=8094
